# Public values are embedded in the application. Never put secrets here.
EXPO_PUBLIC_DEFAULT_MARKET=GE
# Explicit local demonstration only. Use pairing code TMAP26 when enabled.
EXPO_PUBLIC_DEMO_MODE=false

# Use the EXISTING production TMap Supabase project; never a service-role key.
EXPO_PUBLIC_SUPABASE_URL=
# Modern client key beginning with sb_publishable_ (public, embedded in the app).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required before EAS preview/production builds; optional for local development.
# Use identifiers owned by your organization (without a .dev suffix).
# TMAP_IOS_BUNDLE_IDENTIFIER=com.yourcompany.tmap
# TMAP_ANDROID_PACKAGE=com.yourcompany.tmap
# EAS_PROJECT_ID=
# EXPO_OWNER=
