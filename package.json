{
  "name": "tmap-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "expo:config": "expo config --type public",
    "expo:check": "expo install --check",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "expo:doctor": "expo-doctor",
    "build:android:development": "pnpm dlx eas-cli build --platform android --profile development",
    "build:ios:development": "pnpm dlx eas-cli build --platform ios --profile development"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.1",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "1.20.4",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
