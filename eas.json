{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "TMAP_APP_VARIANT": "development", "EXPO_PUBLIC_DEMO_MODE": "false" },
      "android": { "buildType": "apk" }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "TMAP_APP_VARIANT": "preview", "EXPO_PUBLIC_DEMO_MODE": "false" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": { "TMAP_APP_VARIANT": "production", "EXPO_PUBLIC_DEMO_MODE": "false" },
      "android": { "buildType": "app-bundle" }
    }
  }
}
